@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cwl: <https://w3id.org/cwl/cwl#> .
@prefix ogcproc: <http://www.opengis.net/def/ogcapi/processes/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix s: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:eoap:cwl-to-ogcprocess#> .

# Transform CWL Workflow to OGC Process
:CWLWorkflowToOGCProcess
    a sh:NodeShape ;
    sh:targetClass cwl:Workflow ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            PREFIX cwl: <https://w3id.org/cwl/cwl#>
            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>
            PREFIX dct: <http://purl.org/dc/terms/>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

            CONSTRUCT {
                $this a ogcproc:Process ;
                    ogcproc:processID ?id ;
                    ogcproc:title ?label ;
                    ogcproc:description ?doc
            }
            WHERE {
                $this a cwl:Workflow .
                OPTIONAL { $this dct:identifier ?id }
                OPTIONAL { $this rdfs:label ?label }
                OPTIONAL { $this rdfs:comment ?doc }
            }
        """ ;
    ] ;
.

# Transform CWL CommandLineTool to OGC Process
:CWLCommandLineToolToOGCProcess
    a sh:NodeShape ;
    sh:targetClass cwl:CommandLineTool ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            PREFIX cwl: <https://w3id.org/cwl/cwl#>
            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>
            PREFIX dct: <http://purl.org/dc/terms/>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

            CONSTRUCT {
                $this a ogcproc:Process ;
                    ogcproc:processID ?id ;
                    ogcproc:title ?label ;
                    ogcproc:description ?doc
            }
            WHERE {
                $this a cwl:CommandLineTool .
                OPTIONAL { $this dct:identifier ?id }
                OPTIONAL { $this rdfs:label ?label }
                OPTIONAL { $this rdfs:comment ?doc }
            }
        """ ;
    ] ;
.

# Process version.
# NOTE: this is the version of the *application*, taken from the schema.org
# annotations. It must not be confused with cwl:cwlVersion, which is the version
# of the CWL language the document is written in.
:ProcessVersion
    a sh:NodeShape ;
    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>
            PREFIX s: <https://schema.org/>

            CONSTRUCT {
                $this ogcproc:version ?version
            }
            WHERE {
                { $this s:softwareVersion ?version }
                UNION
                { $this s:version ?version
                  FILTER NOT EXISTS { $this s:softwareVersion ?sv } }
            }
        """ ;
    ] ;
.

# Preserve every schema.org annotation as an OGC API - Processes metadata entry,
# keyed by the fully expanded IRI of the term. Terms that map onto a dedicated
# process member (version, keywords) are excluded.
:ProcessMetadataFromAnnotations
    a sh:NodeShape ;
    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>
            PREFIX s: <https://schema.org/>

            CONSTRUCT {
                $this ogcproc:metadata [
                    ogcproc:role ?role ;
                    ogcproc:value ?value
                ]
            }
            WHERE {
                $this ?role ?value .
                FILTER(STRSTARTS(STR(?role), "https://schema.org/")
                    || STRSTARTS(STR(?role), "http://schema.org/"))
                FILTER(?role NOT IN (s:keywords, s:version, s:softwareVersion))
            }
        """ ;
    ] ;
.

# Add process execution mode metadata.
# A CWL process is deployed through OGC API - Processes Part 2 and can only be
# executed asynchronously, hence async-execute is the sole job control option.
:ProcessExecutionMode
    a sh:NodeShape ;
    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

            CONSTRUCT {
                $this ogcproc:jobControlOptions "async-execute"^^xsd:string ;
                    ogcproc:outputTransmission "value"^^xsd:string ,
                        "reference"^^xsd:string ;
                    ogcproc:mutable true
            }
            WHERE {
                $this a ?processClass
            }
        """ ;
    ] ;
.

# Link CWL process to OGC conformance classes
:ProcessConformance
    a sh:NodeShape ;
    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            PREFIX dct: <http://purl.org/dc/terms/>

            CONSTRUCT {
                $this dct:conformsTo <http://www.opengis.net/spec/ogcapi-processes-1/1.0/conf/core> ,
                    <http://www.opengis.net/spec/ogcapi-processes-1/1.0/conf/json> ,
                    <http://www.opengis.net/spec/ogcapi-processes-2/1.0/conf/deploy-replace-undeploy> ,
                    <https://www.commonwl.org/v1.2/>
            }
            WHERE {
                $this a ?processClass
            }
        """ ;
    ] ;
.

# Process keywords, from the schema.org annotation or from the CWL intent field.
# NOTE: the previous version of this rule read prov:wasInfluencedBy, a property
# no CWL document ever carries, so it never produced anything.
:ProcessKeywords
    a sh:NodeShape ;
    sh:targetClass cwl:Workflow, cwl:CommandLineTool ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            PREFIX cwl: <https://w3id.org/cwl/cwl#>
            PREFIX ogcproc: <http://www.opengis.net/def/ogcapi/processes/>
            PREFIX s: <https://schema.org/>

            CONSTRUCT {
                $this ogcproc:keywords ?keyword
            }
            WHERE {
                { $this s:keywords ?keyword }
                UNION
                { $this cwl:intent ?keyword }
            }
        """ ;
    ] ;
.
