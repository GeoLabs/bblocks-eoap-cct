{
  "id": "feature-workflow",
  "version": "1.0.0",
  "title": "GeoJSON Feature Processing Workflow",
  "description": "Workflow that processes GeoJSON Feature input and generates output",
  "mutable": true,
  "metadata": [
    {
      "role": "https://schema.org/name",
      "value": "GeoJSON Feature Processing Workflow"
    },
    {
      "role": "https://schema.org/description",
      "value": "Workflow that processes GeoJSON Feature input and generates output"
    },
    {
      "role": "https://schema.org/softwareVersion",
      "value": "1.0.0"
    }
  ],
  "inputs": {
    "aoi": {
      "title": "Area of interest",
      "description": "Area of interest defined in GeoJSON format",
      "schema": {
        "allOf": [
          {
            "format": "geojson-feature"
          },
          {
            "$ref": "https://geojson.org/schema/Feature.json"
          }
        ]
      },
      "minOccurs": 1,
      "maxOccurs": 1
    }
  },
  "outputs": {
    "echo_output": {
      "title": "Echo output",
      "description": "Echoed GeoJSON Feature information",
      "schema": {
        "type": "string",
        "contentMediaType": "application/octet-stream"
      }
    }
  },
  "jobControlOptions": [
    "async-execute",
    "dismiss"
  ],
  "outputTransmission": [
    "value",
    "reference"
  ]
}